# Copie este arquivo para ".env" e preencha os valores. Nunca commite o ".env" real.

# SQL Server: mínimo de 8 caracteres, com maiúscula, minúscula, número e símbolo.
# Evite ; = " $ para não quebrar a connection string.
# Atenção: a senha só é aplicada na primeira criação do volume do banco (veja o README).
MSSQL_SA_PASSWORD=

# Chave de assinatura do JWT (mínimo de 32 bytes). Para gerar uma no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ou, com openssl: openssl rand -base64 48
JWT_CHAVE=

# Administrador criado na primeira execução da API (o CPF precisa ser válido)
BOOTSTRAP_ADMIN_NAME="Administrador"
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_CPF=11144477735
BOOTSTRAP_ADMIN_PASSWORD=